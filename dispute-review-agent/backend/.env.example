# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Knowledge base: PostgreSQL 13+ with pgvector 0.8+ (see ../docker-compose.yml)
DATABASE_URL=postgres://dispute:dispute@localhost:5432/dispute_review

# Local open-source models via Ollama (https://ollama.com, MIT)
#   ollama pull bge-m3 && ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3          # MIT, multilingual
EMBED_DIM=1024              # must match EMBED_MODEL; fixed once the table exists
LLM_MODEL=qwen2.5:7b        # Apache-2.0; use qwen2.5:1.5b on low-RAM machines
# Optional: describe photos with a vision model, e.g. moondream (Apache-2.0)
VISION_MODEL=

# Uploads and OCR (tesseract.js language codes joined by +)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
OCR_LANGS=eng+chi_sim

# Company internal API — leave empty to use the built-in mock
COMPANY_API_BASE_URL=
COMPANY_API_TOKEN=

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
