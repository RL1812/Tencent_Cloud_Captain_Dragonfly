# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Knowledge base: PostgreSQL 13+ with pgvector 0.8+ (see ../docker-compose.yml)
DATABASE_URL=postgres://dispute:dispute@localhost:5432/dispute_review

# Local open-source models via Ollama (https://ollama.com, MIT)
#   ollama pull bge-m3 && ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3          # MIT, multilingual
EMBED_DIM=1024              # must match EMBED_MODEL; fixed once the table exists
LLM_MODEL=qwen2.5:7b        # Apache-2.0; use qwen2.5:1.5b on low-RAM machines
# Optional: describe photos with a vision model, e.g. moondream (Apache-2.0)
VISION_MODEL=

# Uploads and OCR (tesseract.js language codes joined by +)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
OCR_LANGS=eng+chi_sim

# Dispute-review agents (Rider Advocate, Driver Advocate, Judge)
# Google Gemini free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL fails (high demand, quota, retired model)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# low | medium | high — how long the model thinks before answering
GEMINI_REASONING_EFFORT=low
# Alternative when GEMINI_API_KEY is empty: Tencent TokenHub
TOKENHUB_API_KEY=
# Per model call: give up after this long in total, or this long without any output
LLM_TIMEOUT_MS=240000
LLM_IDLE_TIMEOUT_MS=90000

# Human decisions the AI Judge learns from, and how many go in its prompt
PRECEDENTS_FILE=data/precedents.json
PRECEDENT_EXAMPLES=3

# Company internal API — leave empty to use the built-in mock
COMPANY_API_BASE_URL=
COMPANY_API_TOKEN=

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
